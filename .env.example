# =============================================================================
# [Proje Adı] — Ortam değişkenleri şablonu (.env.example)
#
# KULLANIM: Bu dosyayı ".env" adıyla kopyalayın ve gerçek değerleri yalnızca
#           ".env" içine yazın. ".env" .gitignore'dadır; bu şablon repoda izlenir.
# KURAL   : Buraya ASLA gerçek anahtar yazılmaz; yalnızca sahte / boş değer.
# ADLANDIRMA: config.yaml anahtarını ezen değişken <ÖNEK>_<BÖLÜM>_<ANAHTAR> biçimindedir.
# =============================================================================

# --- 1. Gizli değerler (yalnızca .env içinde doldurulur) ---
APP_API_KEY=
APP_DATABASE_URL=

# --- 2. config.yaml ezmeleri (isteğe bağlı) ---
# APP_SYSTEM_TIMEOUT_SEC=10
# APP_LOGGING_LEVEL=INFO
