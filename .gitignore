# =============================================================================
# MFMX Standart .gitignore Şablonu
# =============================================================================

# --- Güvenlik & Gizlilik (Secrets & Keys) ---
.env
.env.*
!.env.example
*.pem
*.key
*.token
*.cert
credentials.json

# --- İşletim Sistemi ve IDE Artıkları ---
.DS_Store
Thumbs.db
*~
*.swp
*.swo
.kate-swp
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
venv/
.venv/
ENV/

# --- Node.js / JavaScript ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.astro/
.next/
.nuxt/

# --- Go / Rust / Derleme Çıktıları ---
*.exe
*.exe~
*.dll
*.so
*.dylib
*.out
/bin/
/pkg/
/target/

# --- Çalışma Zamanı Logları ve Geçici Durum Dosyaları ---
*.log
logs/
*.pid
*.seed
*.health
tmp/
temp/
